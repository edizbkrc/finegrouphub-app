{
  "name": "finegrouphub-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=2048 node ./node_modules/next/dist/bin/next dev --turbopack",
    "dev:webpack": "cross-env NODE_OPTIONS=--max-old-space-size=2048 node ./node_modules/next/dist/bin/next dev",
    "dev:test": "dotenv -e .env.test -- cross-env NEXT_PUBLIC_APP_ENV=test next dev --turbopack",
    "build": "dotenv -e .env.production -- cross-env NEXT_PUBLIC_APP_ENV=production next build",
    "build:local": "dotenv -e .env -- cross-env NEXT_PUBLIC_APP_ENV=local NODE_OPTIONS=--max-old-space-size=3072 node ./node_modules/next/dist/bin/next build && node scripts/copy-standalone-static.mjs",
    "build:production": "dotenv -e .env.production -- cross-env NEXT_PUBLIC_APP_ENV=production next build",
    "build:test": "dotenv -e .env.test -- cross-env NEXT_PUBLIC_APP_ENV=test next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "start:local": "node scripts/copy-standalone-static.mjs && dotenv -e .env -- cross-env NEXT_PUBLIC_APP_ENV=local PORT=3000 node .next/standalone/server.js",
    "copy:standalone": "node scripts/copy-standalone-static.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "e2e": "cypress open",
    "verify:api": "node scripts/verify-api.mjs",
    "e2e:login": "node scripts/e2e-login.mjs"
  },
