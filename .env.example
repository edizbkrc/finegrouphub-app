# FineGroupHub Panel — ortam değişkenleri şablonu
#
# Bu dosya commit'lenir ve tüm anahtarların referansıdır.
# Gerçek değerler için: `cp .env.example .env` ve doldur.
#
# ⚠️ Env değişkenleri BUILD-TIME gömülür (next.config.ts `env:` bloğu).
#    Değer değişirse imajın yeniden build edilmesi gerekir; container'ı
#    yeniden başlatmak yetmez. Bkz. docs/API_ADAPTER.md ve REBUILD_PROMPT §8.4.
#
# ⚠️ SESSION_SECRET ve LOG_API_SECRET gizlidir; .env.test / .env.production
#    içinde BOŞ bırakılır ve CI tarafından process env olarak enjekte edilir.
#    dotenv mevcut process env'i ezmediği için pipeline değeri kazanır.

# local | test | production
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_NAME=FineGroupHub

# Laravel API tabanı — `/hubapi` DAHİL, sonunda / olmadan (rotalar: {taban}/v1/...)
NEXT_PUBLIC_API_URL=http://localhost:8000/hubapi

# Görsel CDN kökü — next.config.ts images.remotePatterns bundan türetilir
NEXT_PUBLIC_IMAGE_BASE_URL=

# Yerel Fine3D: http://localhost:3001 — prod: https://app.fine3d.com.tr
NEXT_PUBLIC_FINE3D_URL=

# jose ile imzalanan httpOnly session cookie'sinin anahtarı.
# D3 (docs/API_ADAPTER.md §4): referans projede koda gömülüydü. Asla commit'leme.
SESSION_SECRET=

# /api/client-log HMAC imzalama anahtarı (sunucu tarafı doğrulama)
LOG_API_SECRET=
# Aynı anahtarın client'a açılan kopyası (imza üretimi için)
NEXT_PUBLIC_LOG_API_SECRET=
